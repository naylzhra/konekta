# Copy to infra/azure/.env on the VM (gitignored) and fill in.

# The VM's DNS name (Azure portal → VM → Overview → DNS name), e.g.
# konekta.eastasia.cloudapp.azure.com. Caddy gets a TLS cert for it.
API_DOMAIN=konekta.eastasia.cloudapp.azure.com

# Long random string, e.g. `openssl rand -hex 24`. Only read on the first
# boot of an empty postgres volume — changing it later won't change the DB.
POSTGRES_PASSWORD=change-me

# Comma-separated browser origins allowed to call the gateway. Only matters
# for the dashboard (the mobile app isn't subject to CORS).
CORS_ORIGINS=http://localhost:5173

# Demo-only driver simulator.
BOOKING_SIMULATOR=0
