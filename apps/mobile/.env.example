# Not read by the app: configuration goes through --dart-define (see
# dart_defines.example.json). API_BASE_URL defaults to the emulator alias;
# the WebSocket URL is derived from it (https -> wss).
#   Azure:    API_BASE_URL=https://konekta.eastasia.cloudapp.azure.com
#   Local:    API_BASE_URL=http://10.0.2.2:8000
