<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Flutter-engine native splash (API 21+). Matches
     core/theme/konekta_theme.dart's AppColors.primaryContainer + the
     white-tinted KonektaLogo shown by SplashScreen, so there's no
     white/default-icon flash before Flutter's first frame draws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:tint="@android:color/white"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
