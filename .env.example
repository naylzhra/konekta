# Copy to .env and adjust as needed. docker-compose (infra/docker) reads
# these for local dev; each service also has its own .env.example where
# relevant (apps/dashboard, apps/mobile).

# --- Database (Postgres + PostGIS) ---
DATABASE_URL=postgresql://konekta:konekta@localhost:5432/konekta

# --- Redis (GEO commands for live feeder location) ---
REDIS_URL=redis://localhost:6379/0

# --- OSRM ---
# TODO(bandung-map-data): points at services/osrm-mock by default, since
# the real Bandung .osm.pbf extract hasn't been processed into .osrm files
# yet. Swap this to a real OSRM server's URL later — no code changes
# needed in pooling-service's OSRM client.
OSRM_BASE_URL=http://localhost:5001
